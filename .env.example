# Copy to .env. Only VITE_* variables are exposed to the browser – never put secrets here.

# Leave empty in development: the Vite dev server proxies /api to the backend (same origin, no CORS/cookie issues).
# Set to the deployed API origin in production, e.g. https://api.example.com (no trailing slash).
VITE_API_URL=

# Optional: where the dev proxy forwards /api (default http://127.0.0.1:5000)
# VITE_DEV_API_TARGET=http://127.0.0.1:5000
